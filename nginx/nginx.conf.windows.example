events {
}

http {
    # found in nginx/conf/mime.types, where nginx is installed
    include mime.types;

    server {
        listen 80;
        server_name _;

        # CHANGE THIS PATH
        root C:/path/to/your/music-app/frontend/dist;

        # React frontend
        location / {
            try_files $uri $uri/ /index.html;
        }

        # Fastify API
        location /api/ {
            proxy_pass http://127.0.0.1:3000;

            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Music files / streaming
        location /music/ {
            proxy_pass http://127.0.0.1:3000;

            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}